{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHANTOM lifecycle phase result",
  "type": "object",
  "required": ["schema_version", "phase", "component", "profile", "status", "reason", "duration_ms", "terminal_state", "hardware_evidence_state"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "phase": {"enum": ["PROVISION", "TRANSFER", "INSTALL", "START", "DEBUG", "DEVICE INTEGRATION TEST", "RECOVERY"]},
    "component": {"enum": ["QUEST", "EV3", "PAIR"]},
    "profile": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL"]},
    "reason": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "duration_ms": {"type": "integer", "minimum": 0},
    "terminal_state": {"type": "string", "minLength": 1},
    "hardware_evidence_state": {"enum": ["NOT_QUALIFICATION_EVIDENCE", "DEVICE"]},
    "build_id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "artifact_sha256": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        {"type": "object", "additionalProperties": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}}
      ]
    },
    "steps": {"type": "array"}
  },
  "additionalProperties": true
}
