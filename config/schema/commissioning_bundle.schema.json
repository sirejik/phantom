{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phantom.local/schema/commissioning-bundle-v1",
  "type":"object",
  "required":["schema_version","revision","bundle_id","mechanical_revision","qualification_status","robot_geometry","drive_calibration","collision_model","joint_safe_sets","payload_profiles","safety_envelope"],
  "properties":{
    "schema_version":{"const":1},"revision":{"type":"integer","minimum":1},"bundle_id":{"type":"string","minLength":1},"mechanical_revision":{"type":"string","minLength":1},
    "qualification_status":{"enum":["UNQUALIFIED","QUALIFIED"]},
    "robot_geometry":{"type":"object","required":["branch_sign","l1_m","l2_m"],"properties":{"branch_sign":{"enum":[-1,1]},"l1_m":{"type":["number","null"]},"l2_m":{"type":["number","null"]}}},
    "drive_calibration":{"type":"object"},"collision_model":{"type":"object"},"joint_safe_sets":{"type":"object"},"payload_profiles":{"type":"object"},"safety_envelope":{"type":"object"}
  },"additionalProperties":false
}
