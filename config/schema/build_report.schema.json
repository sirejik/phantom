{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PHANTOM BUILD result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "phase", "status", "component", "profile", "qualification_eligible", "build_id", "artifact_path", "artifact_sha256", "config_hash", "protocol_schema_hash", "protocol_semantics_hash", "protocol_contract_hash"],
  "properties": {
    "schema_version": {"const": 1},
    "phase": {"const": "BUILD"},
    "status": {"const": "PASS"},
    "component": {"enum": ["QUEST", "EV3"]},
    "profile": {"enum": ["Release", "Diagnostic", "DeepDebug"]},
    "qualification_eligible": {"type": "boolean"},
    "build_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "config_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_schema_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_semantics_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "protocol_contract_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "apk_signing_certificate_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"profile": {"const": "DeepDebug"}}}, "then": {"properties": {"qualification_eligible": {"const": false}}}}
  ]
}
