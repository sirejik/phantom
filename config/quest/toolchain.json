{
  "unity": {
    "override_environment_variable": "PHANTOM_UNITY_ROOT",
    "search_paths": [
      "C:\\Program Files\\Unity\\Hub\\Editor\\{version}",
      "C:\\Program Files (x86)\\Unity\\Hub\\Editor\\{version}",
      "D:\\Unity\\Hub\\Editor\\{version}"
    ]
  },
  "android": {
    "override_environment_variable": "PHANTOM_ADB",
    "adb_relative_paths": [
      "PlaybackEngines/AndroidPlayer/SDK/platform-tools/adb.exe"
    ],
    "adb_search_paths": [
      "C:\\Android\\platform-tools\\adb.exe"
    ]
  },
  "dotnet": {
    "override_environment_variable": "PHANTOM_DOTNET",
    "sdk_specification": "PhantomQuest/Tests/Host/global.json",
    "user_install_relative_path": ".dotnet/dotnet.exe"
  }
}
