{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phantom.local/schema/quest-runtime-config-v1",
  "title":"PHANTOM Quest runtime configuration",
  "description":"Canonical machine-readable structure of the Quest runtime configuration artifact. RobotGeometry, DriveCalibration, collision model, payload profiles and safe-sets are loaded only from the versioned CommissioningBundle and are deliberately not duplicated here.",
  "type":"object",
  "required":["schema_version","robot_id","build_profile","qualification","human_mapping","space","hand_tracking","body_tracking","qr","grasp","commissioning_bundle","network"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},
    "robot_id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,32}$"},
    "build_profile":{"enum":["Release","Diagnostic"]},
    "qualification":{
      "type":"object",
      "required":["qualification_only","qualification_evidence_manifest_hash","actuator_scope_mask","safety_observation_mask","required_user_inputs"],
      "additionalProperties":false,
      "properties":{
        "qualification_only":{"type":"boolean"},
        "qualification_evidence_manifest_hash":{"$ref":"#/$defs/hash"},
        "actuator_scope_mask":{"type":"integer","minimum":0,"maximum":15},
        "safety_observation_mask":{"type":"integer","minimum":0,"maximum":15},
        "required_user_inputs":{"enum":["FULL_ARM","GRIPPER_ONLY","NONE"]}
      }
    },
    "human_mapping":{
      "type":"object",
      "required":["arm_reach_min_technical_m","arm_reach_max_technical_m","max_mapping_scale"],
      "additionalProperties":false,
      "properties":{
        "arm_reach_min_technical_m":{"$ref":"#/$defs/measuredNumber"},
        "arm_reach_max_technical_m":{"$ref":"#/$defs/measuredNumber"},
        "max_mapping_scale":{"$ref":"#/$defs/measuredNumber"}
      }
    },
    "space":{
      "type":"object",
      "required":["require_local_floor","require_spatial_data_permission","require_scene_support_for_qr","require_anchor_support_for_qr","require_current_room","require_scene_floor_anchor","scene_aware_ux_enabled"],
      "additionalProperties":false,
      "properties":{
        "require_local_floor":{"type":"boolean"},
        "require_spatial_data_permission":{"type":"boolean"},
        "require_scene_support_for_qr":{"type":"boolean"},
        "require_anchor_support_for_qr":{"type":"boolean"},
        "require_current_room":{"type":"boolean"},
        "require_scene_floor_anchor":{"type":"boolean"},
        "scene_aware_ux_enabled":{"type":"boolean"}
      }
    },
    "hand_tracking":{
      "type":"object",
      "required":["required","wrist_joint","wrist_max_pose_age_ms","wrist_dropout_grace_ms"],
      "additionalProperties":false,
      "properties":{
        "required":{"type":"boolean"},
        "wrist_joint":{"const":"Wrist"},
        "wrist_max_pose_age_ms":{"type":"integer","minimum":1,"maximum":1000},
        "wrist_dropout_grace_ms":{"$ref":"#/$defs/measuredInteger"}
      }
    },
    "body_tracking":{
      "type":"object",
      "required":["required","joint_set","shoulder_joint","require_iobt","max_pose_age_ms","qualification_profile_id","require_runtime_profile_match"],
      "additionalProperties":false,
      "properties":{
        "required":{"type":"boolean"},
        "joint_set":{"const":"UPPER_BODY"},
        "shoulder_joint":{"const":"Body_RightShoulder"},
        "require_iobt":{"type":"boolean"},
        "max_pose_age_ms":{"type":"integer","minimum":1,"maximum":1000},
        "qualification_profile_id":{"type":"string","minLength":1,"maxLength":64},
        "require_runtime_profile_match":{"type":"boolean"}
      }
    },
    "qr":{
      "type":"object",
      "required":["required_markers","required_only_before_ready","runtime_tracking_required"],
      "additionalProperties":false,
      "properties":{
        "required_markers":{"type":"array"},
        "required_only_before_ready":{"type":"boolean"},
        "runtime_tracking_required":{"type":"boolean"}
      }
    },
    "grasp":{
      "type":"object",
      "required":["provider","require_grasp_ready","default_mapping","fallback_provider"],
      "additionalProperties":false,
      "properties":{
        "provider":{"enum":["OPENXR_HAND_INTERACTION","DISABLED"]},
        "require_grasp_ready":{"type":"boolean"},
        "default_mapping":{"const":"IDENTITY"},
        "fallback_provider":{"enum":["OPENXR_HAND_INTERACTION","DISABLED"]}
      }
    },
    "commissioning_bundle":{
      "type":"object","required":["expected_hash"],"additionalProperties":false,
      "properties":{"expected_hash":{"$ref":"#/$defs/hash"}}
    },
    "network":{
      "type":"object",
      "required":["discovery_service_type","discovery_domain","ip_family","default_port","protocol_version","control_key_id","commissioning_key_id","telemetry_max_age_ms","hello_retry_ms","hello_max_attempts","ping_interval_ms","ping_timeout_ms","max_missed_pongs","reconnect_delay_ms"],
      "additionalProperties":false,
      "properties":{
        "discovery_service_type":{"const":"_phantom-ev3._udp"},
        "discovery_domain":{"const":"local."},
        "ip_family":{"const":"IPV4"},
        "default_port":{"type":"integer","minimum":1024,"maximum":65535},
        "protocol_version":{"const":1},
        "control_key_id":{"type":"string","minLength":1,"maxLength":64},
        "commissioning_key_id":{"type":["string","null"]},
        "telemetry_max_age_ms":{"type":"integer","minimum":1,"maximum":60000},
        "hello_retry_ms":{"type":"integer","minimum":10,"maximum":60000},
        "hello_max_attempts":{"type":"integer","minimum":1,"maximum":20},
        "ping_interval_ms":{"type":"integer","minimum":10,"maximum":60000},
        "ping_timeout_ms":{"type":"integer","minimum":10,"maximum":60000},
        "max_missed_pongs":{"type":"integer","minimum":1,"maximum":10},
        "reconnect_delay_ms":{"type":"integer","minimum":10,"maximum":60000}
      }
    }
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "measuredNumber":{"type":["number","string","null"]},
    "measuredInteger":{"type":["integer","string","null"]}
  }
}
