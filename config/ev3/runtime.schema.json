{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://phantom.local/schema/ev3-runtime-config-v1",
  "title":"PHANTOM EV3 runtime configuration",
  "description":"Canonical machine-readable structure of the EV3 runtime configuration artifact. Physical geometry, DriveCalibration, JointSafeSet, payload profiles and the SafetyEnvelope belong to commissioning_bundle.schema.json and are deliberately not duplicated here.",
  "type":"object",
  "required":["schema_version","robot_id","build_profile","qualification_only","qualification_evidence_manifest_hash","actuator_scope_mask","safety_observation_mask","axes","local_stop","gripper_home","network","safety","logging"],
  "additionalProperties":false,
  "properties":{
    "schema_version":{"const":1},
    "robot_id":{"type":"string","pattern":"^[A-Za-z0-9_-]{1,32}$"},
    "build_profile":{"enum":["Release","Diagnostic"]},
    "qualification_only":{"type":"boolean"},
    "qualification_evidence_manifest_hash":{"$ref":"#/$defs/hash"},
    "actuator_scope_mask":{"type":"integer","minimum":0,"maximum":15},
    "safety_observation_mask":{"type":"integer","minimum":0,"maximum":15},
    "axes":{
      "type":"object",
      "required":["base","shoulder","elbow","gripper"],
      "additionalProperties":false,
      "properties":{
        "base":{"$ref":"#/$defs/largeAxis"},
        "shoulder":{"$ref":"#/$defs/flexionAxis"},
        "elbow":{"$ref":"#/$defs/flexionAxis"},
        "gripper":{"$ref":"#/$defs/gripperAxis"}
      }
    },
    "local_stop":{
      "type":"object","required":["sensor_port","required"],"additionalProperties":false,
      "properties":{"sensor_port":{"const":"in4"},"required":{"type":"boolean"}}
    },
    "gripper_home":{
      "type":"object","required":["sensor_port","required","debounce_ms"],"additionalProperties":false,
      "properties":{"sensor_port":{"const":"in3"},"required":{"type":"boolean"},"debounce_ms":{"type":["integer","null"],"minimum":0,"maximum":1000}}
    },
    "network":{
      "type":"object",
      "required":["discovery_service_type","discovery_domain","ip_family","listen_port_udp","command_timeout_ms","max_packet_bytes","max_payload_bytes","rx_rate_limit_pps","rx_burst_packets","hello_retry_window_ms","session_stale_ms","max_concurrent_control_sessions"],
      "additionalProperties":false,
      "properties":{
        "discovery_service_type":{"const":"_phantom-ev3._udp"},
        "discovery_domain":{"const":"local."},
        "ip_family":{"const":"IPV4"},
        "listen_port_udp":{"type":"integer","minimum":1024,"maximum":65535},
        "command_timeout_ms":{"type":"integer","minimum":20,"maximum":2000},
        "max_packet_bytes":{"const":1024},
        "max_payload_bytes":{"const":928},
        "rx_rate_limit_pps":{"type":["integer","null"],"minimum":1,"maximum":10000},
        "rx_burst_packets":{"type":["integer","null"],"minimum":1,"maximum":1024},
        "hello_retry_window_ms":{"type":"integer","minimum":100,"maximum":60000},
        "session_stale_ms":{"type":"integer","minimum":200,"maximum":300000},
        "max_concurrent_control_sessions":{"const":1}
      }
    },
    "safety":{
      "type":"object",
      "required":["ready_gate","external_power_cut_required","controller_heartbeat_rate_hz","controller_heartbeat_timeout_ms","loop_safe_hold_ms","loop_fault_ms","motor_output_default","measured_limits_complete"],
      "additionalProperties":false,
      "properties":{
        "ready_gate":{"enum":["FAIL_CLOSED_UNTIL_COMMISSIONED","NETWORK_ONLY_NO_ACTUATOR_AUTHORITY"]},
        "external_power_cut_required":{"type":"boolean"},
        "controller_heartbeat_rate_hz":{"type":"integer","minimum":20,"maximum":100},
        "controller_heartbeat_timeout_ms":{"type":"integer","minimum":20,"maximum":1000},
        "loop_safe_hold_ms":{"type":"integer","minimum":25,"maximum":1000},
        "loop_fault_ms":{"type":"integer","minimum":30,"maximum":2000},
        "motor_output_default":{"const":"BRAKE_ZERO"},
        "measured_limits_complete":{"type":"boolean"}
      }
    },
    "logging":{
      "type":"object",
      "required":["flight_recorder_seconds","flight_recorder_rate_hz","release_retention_days","release_max_mb"],
      "additionalProperties":false,
      "properties":{
        "flight_recorder_seconds":{"type":"integer","minimum":1,"maximum":60},
        "flight_recorder_rate_hz":{"type":"integer","minimum":10,"maximum":100},
        "release_retention_days":{"type":"integer","minimum":1,"maximum":365},
        "release_max_mb":{"type":"integer","minimum":1,"maximum":4096}
      }
    }
  },
  "$defs":{
    "hash":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "axisLimits":{"type":["string","null"],"enum":["MEASURED_REQUIRED","OUT_OF_SCOPE",null]},
    "largeAxis":{
      "type":"object","required":["motor_port","motor_type","limits"],"additionalProperties":false,
      "properties":{"motor_port":{"enum":["outA","outB","outC","outD"]},"motor_type":{"const":"ev3-large"},"limits":{"$ref":"#/$defs/axisLimits"}}
    },
    "flexionAxis":{
      "type":"object","required":["motor_port","motor_type","flexion_max_deg","limits"],"additionalProperties":false,
      "properties":{"motor_port":{"enum":["outA","outB","outC","outD"]},"motor_type":{"const":"ev3-large"},"flexion_max_deg":{"type":"integer","minimum":1,"maximum":90},"limits":{"$ref":"#/$defs/axisLimits"}}
    },
    "gripperAxis":{
      "type":"object","required":["motor_port","motor_type","limits"],"additionalProperties":false,
      "properties":{"motor_port":{"const":"outD"},"motor_type":{"const":"ev3-medium"},"limits":{"$ref":"#/$defs/axisLimits"}}
    }
  }
}
