{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schema/quest-startup-localization-v1",
  "description": "Transient Quest localization for the current controller boot and reference space; never restored as current pose after restart. Physical startup producer belongs to future implementation stages.",
  "type": "object",
  "required": [
    "schema_version",
    "controller_boot_id",
    "commissioning_bundle_hash",
    "reference_space_revision",
    "captured_monotonic_us",
    "T_floor_base"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "controller_boot_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "commissioning_bundle_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference_space_revision": {
      "type": "integer",
      "minimum": 1
    },
    "captured_monotonic_us": {
      "type": "integer",
      "minimum": 0
    },
    "T_floor_base": {
      "type": "array",
      "minItems": 16,
      "maxItems": 16,
      "items": {
        "type": "number"
      }
    }
  }
}
