{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phantom.local/schema/ev3-runtime-config",
  "title": "PHANTOM EV3 runtime configuration",
  "description": "Structure of the installed EV3 runtime configuration. EV3 commissioning data is validated by commissioning.schema.json.",
  "type": "object",
  "required": [
    "robot_id",
    "build_profile",
    "qualification_only",
    "actuator_scope_mask",
    "safety_observation_mask",
    "axes",
    "local_stop",
    "gripper_home",
    "network",
    "safety",
    "logging"
  ],
  "additionalProperties": false,
  "properties": {
    "robot_id": {
      "const": "phantom01"
    },
    "build_profile": {
      "enum": [
        "Release",
        "Diagnostic"
      ]
    },
    "qualification_only": {
      "type": "boolean"
    },
    "actuator_scope_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "safety_observation_mask": {
      "type": "integer",
      "minimum": 0,
      "maximum": 15
    },
    "axes": {
      "type": "object",
      "required": [
        "base",
        "shoulder",
        "elbow",
        "gripper"
      ],
      "additionalProperties": false,
      "properties": {
        "base": {
          "$ref": "#/$defs/largeAxis"
        },
        "shoulder": {
          "$ref": "#/$defs/flexionAxis"
        },
        "elbow": {
          "$ref": "#/$defs/flexionAxis"
        },
        "gripper": {
          "$ref": "#/$defs/gripperAxis"
        }
      }
    },
    "local_stop": {
      "type": "object",
      "required": [
        "sensor_port"
      ],
      "additionalProperties": false,
      "properties": {
        "sensor_port": {
          "const": "in4"
        }
      }
    },
    "gripper_home": {
      "type": "object",
      "required": [
        "sensor_port"
      ],
      "additionalProperties": false,
      "properties": {
        "sensor_port": {
          "const": "in3"
        }
      }
    },
    "network": {
      "type": "object",
      "required": [
        "discovery_service_type",
        "discovery_domain",
        "ip_family",
        "listen_port_udp",
        "command_timeout_ms",
        "max_packet_bytes",
        "max_payload_bytes",
        "rx_rate_limit_pps",
        "rx_burst_packets",
        "hello_retry_window_ms",
        "session_stale_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "discovery_service_type": {
          "const": "_phantom-ev3._udp"
        },
        "discovery_domain": {
          "const": "local."
        },
        "ip_family": {
          "const": "IPV4"
        },
        "listen_port_udp": {
          "type": "integer",
          "minimum": 1024,
          "maximum": 65535
        },
        "command_timeout_ms": {
          "type": "integer",
          "minimum": 20,
          "maximum": 2000
        },
        "max_packet_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_payload_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "rx_rate_limit_pps": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "rx_burst_packets": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "hello_retry_window_ms": {
          "type": "integer",
          "minimum": 100,
          "maximum": 60000
        },
        "session_stale_ms": {
          "type": "integer",
          "minimum": 200,
          "maximum": 300000
        }
      }
    },
    "safety": {
      "type": "object",
      "required": [
        "controller_heartbeat_rate_hz",
        "controller_heartbeat_timeout_ms",
        "loop_safe_hold_ms",
        "loop_fault_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "controller_heartbeat_rate_hz": {
          "type": "integer",
          "minimum": 20,
          "maximum": 100
        },
        "controller_heartbeat_timeout_ms": {
          "type": "integer",
          "minimum": 20,
          "maximum": 1000
        },
        "loop_safe_hold_ms": {
          "type": "integer",
          "minimum": 25,
          "maximum": 1000
        },
        "loop_fault_ms": {
          "type": "integer",
          "minimum": 30,
          "maximum": 2000
        }
      }
    },
    "logging": {
      "type": "object",
      "required": [
        "flight_recorder_seconds",
        "flight_recorder_rate_hz",
        "release_retention_days",
        "release_max_mb"
      ],
      "additionalProperties": false,
      "properties": {
        "flight_recorder_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "flight_recorder_rate_hz": {
          "type": "integer",
          "minimum": 10,
          "maximum": 100
        },
        "release_retention_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "release_max_mb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4096
        }
      }
    }
  },
  "$defs": {
    "largeAxis": {
      "type": "object",
      "required": [
        "motor_port"
      ],
      "additionalProperties": false,
      "properties": {
        "motor_port": {
          "enum": [
            "outA",
            "outB",
            "outC",
            "outD"
          ]
        }
      }
    },
    "flexionAxis": {
      "type": "object",
      "required": [
        "motor_port"
      ],
      "additionalProperties": false,
      "properties": {
        "motor_port": {
          "enum": [
            "outA",
            "outB",
            "outC",
            "outD"
          ]
        }
      }
    },
    "gripperAxis": {
      "type": "object",
      "required": [
        "motor_port"
      ],
      "additionalProperties": false,
      "properties": {
        "motor_port": {
          "const": "outD"
        }
      }
    }
  }
}
