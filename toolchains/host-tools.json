{
  "schema_version": 1,
  "description": "Declared host tooling for PHANTOM TEST and BUILD phases. Every entry has an environment override so a workstation with a different layout needs no script edits. The Unity version itself is pinned by PhantomQuest/ProjectSettings/ProjectVersion.txt, never here.",
  "unity": {
    "override_environment_variable": "PHANTOM_UNITY_ROOT",
    "search_paths": [
      "C:\\Program Files\\Unity\\Hub\\Editor\\{version}",
      "C:\\Program Files (x86)\\Unity\\Hub\\Editor\\{version}",
      "D:\\Unity\\Hub\\Editor\\{version}"
    ]
  },
  "android": {
    "override_environment_variable": "PHANTOM_ADB",
    "adb_relative_paths": [
      "PlaybackEngines\\AndroidPlayer\\SDK\\platform-tools\\adb.exe"
    ],
    "adb_search_paths": [
      "C:\\Android\\platform-tools\\adb.exe"
    ]
  },
  "wsl": {
    "override_environment_variable": "PHANTOM_WSL_DISTRO",
    "distribution": "Ubuntu",
    "required_packages": ["cmake", "ninja-build", "g++"]
  },
  "dotnet": {
    "override_environment_variable": "PHANTOM_DOTNET",
    "sdk_specification": "PhantomQuest/Tests/Host/global.json",
    "user_install_relative_path": ".dotnet/dotnet.exe"
  },
  "docker": {
    "required": true,
    "ev3_toolchain_lock": "ev3/toolchains/ev3dev-stretch.lock.json"
  }
}
