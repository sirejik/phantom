#!/usr/bin/env sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
REPO_ROOT=$(CDPATH= cd -- "$SCRIPT_DIR/.." && pwd)
EV3_HOST=${EV3_HOST:-robot@192.168.0.1}
EV3_USER=${EV3_USER:-${EV3_HOST%@*}}
EV3_ROOT=${EV3_ROOT:-/home/robot/phantom-bench}
EV3_SSH_PORT=${EV3_SSH_PORT:-22}
EV3_SSH_STATE=${EV3_SSH_STATE:-$REPO_ROOT/.ev3-ssh}
EV3_KNOWN_HOSTS=${EV3_KNOWN_HOSTS:-$EV3_SSH_STATE/known_hosts}
EV3_SSH_KEY=${EV3_SSH_KEY:-$EV3_SSH_STATE/id_ed25519}

# Git for Windows can fail to create ~/.ssh when the Windows profile contains
# non-ASCII characters. Keep bench-specific host state in the ASCII workspace.
mkdir -p "$EV3_SSH_STATE"
touch "$EV3_KNOWN_HOSTS"

ssh_ev3() {
    if [ -f "$EV3_SSH_KEY" ]; then
        ssh -p "$EV3_SSH_PORT" -i "$EV3_SSH_KEY" -o IdentitiesOnly=yes -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST" "$@"
    else
        ssh -p "$EV3_SSH_PORT" -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST" "$@"
    fi
}

ssh_ev3_tty() {
    if [ -f "$EV3_SSH_KEY" ]; then
        ssh -tt -p "$EV3_SSH_PORT" -i "$EV3_SSH_KEY" -o IdentitiesOnly=yes -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST" "$@"
    else
        ssh -tt -p "$EV3_SSH_PORT" -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST" "$@"
    fi
}

scp_to_ev3() {
    if [ -f "$EV3_SSH_KEY" ]; then
        scp -P "$EV3_SSH_PORT" -i "$EV3_SSH_KEY" -o IdentitiesOnly=yes -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$1" "$EV3_HOST:$2"
    else
        scp -P "$EV3_SSH_PORT" -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$1" "$EV3_HOST:$2"
    fi
}
