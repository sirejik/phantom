#!/usr/bin/env sh
# Run a deliberately interleaved stationary E1 comparison: persistent/reopen x3.
set -eu
. "$(dirname -- "$0")/ev3-bench-common"

if [ "$#" -ne 1 ]; then
    echo "Usage: scripts/ev3-bench-alternating RATE_HZ" >&2
    exit 2
fi
RATE=$1
case "$RATE" in 25|40|50) ;; *) echo "RATE_HZ must be 25, 40, or 50" >&2; exit 2;; esac

RUN_PREFIX=${EV3_RUN_ID:-"e1alt_${RATE}hz_$(date -u +%Y%m%dT%H%M%SZ)"}
case "$RUN_PREFIX" in *[!A-Za-z0-9_.-]*) echo "Unsafe EV3_RUN_ID" >&2; exit 2;; esac

REMOTE_CMD='set -eu; '
INDEX=0
for MODE in persistent naive persistent naive persistent naive; do
    INDEX=$((INDEX + 1))
    REMOTE_CMD="$REMOTE_CMD sudo -n '$EV3_ROOT/bin/ev3-bench' e1 --output '$EV3_ROOT/results/ev3/raw' --run-id '${RUN_PREFIX}_${INDEX}_${MODE}' --duration 120 --rate '$RATE' --mode '$MODE';"
done

echo "Running alternating E1 at ${RATE} Hz: persistent/reopen x3; duty=0, no motor motion."
ssh_ev3_tty "$REMOTE_CMD"
