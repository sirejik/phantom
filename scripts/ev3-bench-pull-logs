#!/usr/bin/env sh
set -eu
. "$(dirname -- "$0")/ev3-bench-common"

LOCAL_RESULTS=${EV3_LOCAL_RESULTS:-$REPO_ROOT/results/ev3}
mkdir -p "$LOCAL_RESULTS/raw"
if [ -f "$EV3_SSH_KEY" ]; then
    scp -r -P "$EV3_SSH_PORT" -i "$EV3_SSH_KEY" -o IdentitiesOnly=yes -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST:$EV3_ROOT/results/ev3/raw/." "$LOCAL_RESULTS/raw/"
else
    scp -r -P "$EV3_SSH_PORT" -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST:$EV3_ROOT/results/ev3/raw/." "$LOCAL_RESULTS/raw/"
fi

for file in environment.json environment.txt; do
    if [ -f "$EV3_SSH_KEY" ]; then
        scp -P "$EV3_SSH_PORT" -i "$EV3_SSH_KEY" -o IdentitiesOnly=yes -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST:$EV3_ROOT/results/ev3/$file" "$LOCAL_RESULTS/$file" 2>/dev/null || true
    else
        scp -P "$EV3_SSH_PORT" -o "UserKnownHostsFile=$EV3_KNOWN_HOSTS" "$EV3_HOST:$EV3_ROOT/results/ev3/$file" "$LOCAL_RESULTS/$file" 2>/dev/null || true
    fi
done
echo "Pulled EV3 results to $LOCAL_RESULTS"
