#!/usr/bin/env sh
# Grants robot only the exact bench binary as root, without a password. This is
# needed because tacho-motor sysfs command attributes are root-writable.
set -eu
. "$(dirname -- "$0")/ev3-bench-common"

case "$EV3_USER" in *[!A-Za-z0-9_.-]*) echo "Unsafe EV3 user name: $EV3_USER" >&2; exit 2;; esac
case "$EV3_ROOT" in *[!A-Za-z0-9_./-]*) echo "Unsafe EV3 root path: $EV3_ROOT" >&2; exit 2;; esac

RULE="$EV3_USER ALL=(root) NOPASSWD: $EV3_ROOT/bin/ev3-bench"
ssh_ev3_tty "printf '%s\\n' '$RULE' | sudo tee /etc/sudoers.d/phantom-ev3-bench >/dev/null && sudo chmod 440 /etc/sudoers.d/phantom-ev3-bench && sudo visudo -cf /etc/sudoers.d/phantom-ev3-bench"
echo "Installed restricted sudo rule for $EV3_USER: $EV3_ROOT/bin/ev3-bench"
