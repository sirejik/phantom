#!/usr/bin/env sh
# Install a bench-specific SSH key on the EV3. This asks for the robot password
# once during provisioning; all other bench scripts then use the key.
set -eu
. "$(dirname -- "$0")/ev3-bench-common"

if [ ! -f "$EV3_SSH_KEY" ]; then
    ssh-keygen -q -t ed25519 -N "" -C "phantom-ev3-bench" -f "$EV3_SSH_KEY"
    echo "Created bench SSH key: $EV3_SSH_KEY"
fi

cat "$EV3_SSH_KEY.pub" | ssh_ev3 "umask 077; mkdir -p ~/.ssh; cat >> ~/.ssh/authorized_keys; chmod 700 ~/.ssh; chmod 600 ~/.ssh/authorized_keys"
echo "Installed public key for $EV3_HOST. Future bench commands will not request the password."
