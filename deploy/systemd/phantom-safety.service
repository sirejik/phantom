[Unit]
Description=PHANTOM local stop and controller supervisor
Before=phantom-controller.service

[Service]
Type=simple
User=root
Group=phantom
RuntimeDirectory=phantom
RuntimeDirectoryMode=0770
RuntimeDirectoryPreserve=yes
LogsDirectory=phantom
LogsDirectoryMode=0750
ExecStart=/opt/phantom/current/bin/phantom-safety
Restart=always
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/phantom /var/log/phantom /sys/class/tacho-motor /sys/class/lego-sensor

[Install]
WantedBy=phantom.target
