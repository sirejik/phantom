[Unit]
Description=PHANTOM authenticated UDP network worker
Requires=phantom-controller.service
Wants=phantom-wifi-autoconnect.service
After=phantom-controller.service phantom-wifi-autoconnect.service
PartOf=phantom.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=90
User=phantom-net
Group=phantom-net
SupplementaryGroups=phantom-ipc
ExecStart=/opt/phantom/current/bin/phantom-network
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/run/phantom/network

[Install]
WantedBy=phantom.target
