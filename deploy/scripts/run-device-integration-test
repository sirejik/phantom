#!/bin/sh
# Explicit DEVICE INTEGRATION TEST launcher. It never builds, provisions, installs or rolls back.
set -eu

expected_build_id=${1:?expected build_id required}
deadline=${2:-360}
result=/var/lib/phantom/device-integration-test.json
case "$expected_build_id" in *[!0-9a-f]*|'') echo "invalid build_id" >&2; exit 1;; esac
test "${#expected_build_id}" = 64 || { echo "invalid build_id length" >&2; exit 1; }
case "$deadline" in *[!0-9]*|'') echo "invalid DEVICE INTEGRATION TEST deadline" >&2; exit 1;; esac
test "$deadline" -gt 0 || { echo "DEVICE INTEGRATION TEST deadline must be positive" >&2; exit 1; }

actual_build_id=$(python3 -c 'import json; print(json.load(open("/opt/phantom/current/build-manifest.json", encoding="utf-8-sig"))["build_id"])')
test "$actual_build_id" = "$expected_build_id" || { echo "installed build_id mismatch" >&2; exit 1; }
build_profile=$(python3 -c 'import json; print(json.load(open("/opt/phantom/current/build-manifest.json", encoding="utf-8-sig")).get("build_profile", "N_A"))')
started_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
started_ms=$(python3 -c 'import time; print(int(time.monotonic()*1000))')

rm -f "$result"
set +e
timeout "$deadline" /opt/phantom/current/bin/phantom-device-integration-test
code=$?
set -e
if test "$code" != 0; then
  for unit in phantom-mdns.service phantom-network.service phantom-controller.service phantom-safety.service phantom.target; do
    systemctl stop "$unit" >/dev/null 2>&1 || true
  done
  for motor in /sys/class/tacho-motor/motor*; do
    test -d "$motor" || continue
    echo 0 > "$motor/duty_cycle_sp" 2>/dev/null || true
    echo brake > "$motor/stop_action" 2>/dev/null || true
    echo stop > "$motor/command" 2>/dev/null || true
  done
  terminal_state=RUNTIME_STOPPED_ZERO_OUTPUT
  for unit in phantom-mdns.service phantom-network.service phantom-controller.service phantom-safety.service phantom.target; do
    if systemctl is-active --quiet "$unit" 2>/dev/null; then terminal_state=SAFE_STATE_VERIFICATION_FAILED; fi
  done
  for motor in /sys/class/tacho-motor/motor*; do
    test -d "$motor" || continue
    test "$(cat "$motor/duty_cycle_sp" 2>/dev/null)" = 0 || terminal_state=SAFE_STATE_VERIFICATION_FAILED
    test "$(cat "$motor/duty_cycle" 2>/dev/null)" = 0 || terminal_state=SAFE_STATE_VERIFICATION_FAILED
    test "$(cat "$motor/speed" 2>/dev/null)" = 0 || terminal_state=SAFE_STATE_VERIFICATION_FAILED
    test "$(cat "$motor/stop_action" 2>/dev/null)" = brake || terminal_state=SAFE_STATE_VERIFICATION_FAILED
  done
  python3 - "$result" "$expected_build_id" "$code" "$terminal_state" "$build_profile" "$started_at" "$started_ms" <<'PY'
import json, os, pathlib, sys, time
path = pathlib.Path(sys.argv[1])
finished_at = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
finished_ms = int(time.monotonic() * 1000)
try:
    payload = json.loads(path.read_text(encoding="utf-8-sig"))
    if not isinstance(payload, dict):
        raise ValueError("report root is not an object")
except (OSError, ValueError):
    payload = {
        "schema_version": 2,
        "phase": "DEVICE INTEGRATION TEST",
        "gate": "DEVICE INTEGRATION TEST",
        "stage": 3,
        "component": "EV3",
        "profile": sys.argv[5],
        "status": "FAIL",
        "reason": "DEVICE_CHECK_FAILED",
        "build_id": sys.argv[2],
        "artifact_sha256": None,
        "started_at": sys.argv[6],
        "finished_at": finished_at,
        "duration_ms": max(0, finished_ms - int(sys.argv[7])),
        "terminal_state": sys.argv[4],
        "hardware_evidence_state": "DEVICE",
        "checks": [{
            "test_id": "device-integration-launcher",
            "status": "FAIL",
            "detail": "runner exited or timed out before producing a valid report",
        }],
    }
payload["status"] = "FAIL"
payload["phase"] = "DEVICE INTEGRATION TEST"
payload["component"] = "EV3"
payload["profile"] = payload.get("profile") or sys.argv[5]
payload["reason"] = "DEVICE_CHECK_FAILED"
payload["started_at"] = payload.get("started_at") or sys.argv[6]
payload["finished_at"] = payload.get("finished_at") or finished_at
payload["duration_ms"] = payload.get("duration_ms", max(0, finished_ms - int(sys.argv[7])))
payload["terminal_state"] = sys.argv[4]
payload["hardware_evidence_state"] = "DEVICE"
payload["launcher_exit_code"] = int(sys.argv[3])
payload["launcher_terminal_state"] = sys.argv[4]
temporary = path.with_suffix(".tmp")
temporary.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n", encoding="utf-8")
os.replace(str(temporary), str(path))
PY
fi
exit "$code"
