#!/bin/sh
set -eu
archive=${1:?release archive required};gate=${2:?PRE-INSTALL report required};root=/opt/phantom
units="phantom-controller.service phantom-safety.service phantom-network.service phantom-mdns.service phantom-wifi-autoconnect.service phantom.target"
runtime_services="phantom-safety.service phantom-wifi-autoconnect.service phantom-controller.service phantom-network.service phantom-mdns.service"
test "$(id -u)" = 0 || { echo "root required" >&2;exit 1; }
release_id=$(basename "$archive" .tar.gz);case "$release_id" in ''|.|..|*[!A-Za-z0-9._-]*) echo "unsafe release id" >&2;exit 1;;esac
dest="$root/releases/$release_id";test ! -e "$dest" || { echo "release exists" >&2;exit 1; }
tar -tzf "$archive" | while IFS= read -r member;do case "$member" in /*|../*|*/../*|*/..) echo "unsafe archive member: $member" >&2;exit 1;;esac;done
mkdir -p "$dest";tar -xzf "$archive" -C "$dest";(cd "$dest"&&sha256sum -c SHA256SUMS)
python3 - "$gate" "$dest/build-manifest.json" "$archive" <<'PY'
import hashlib,json,sys
with open(sys.argv[1],encoding="utf-8-sig") as stream: report=json.load(stream)
with open(sys.argv[2],encoding="utf-8-sig") as stream: manifest=json.load(stream)
if report.get("gate")!="PRE-INSTALL AUTO" or report.get("status")!="PASS" or report.get("worktree_dirty") is not False:raise SystemExit("PRE-INSTALL gate is not a clean PASS")
if report.get("git_commit")!=manifest.get("git_commit") or manifest.get("worktree_dirty") is not False:raise SystemExit("PRE-INSTALL/build manifest source mismatch")
if manifest.get("build_id") not in report.get("build_ids",[]):raise SystemExit("installed build_id is absent from PRE-INSTALL report")
if report.get("specification_sha256")!=manifest.get("specification_sha256") or report.get("protocol_schema_hash")!=manifest.get("protocol_schema_hash"):raise SystemExit("PRE-INSTALL/build contract hash mismatch")
reported={item.get("sha256") for item in report.get("artifacts",[]) if isinstance(item,dict)}
with open(sys.argv[3],"rb") as stream: archive_hash=hashlib.sha256(stream.read()).hexdigest()
if archive_hash not in reported:raise SystemExit("EV3 package SHA-256 is absent from PRE-INSTALL artifact evidence")
for field in ("controller_sha256","safety_sha256"):
    if manifest.get(field) not in reported:raise SystemExit(field+" is absent from PRE-INSTALL artifact evidence")
PY
"$dest/bin/phantom-controller" --self-test;"$dest/bin/phantom-safety" --self-test
python3 -m compileall -q "$dest/bin"
for group in phantom-ipc phantom-safety-ipc phantom-motor;do getent group "$group" >/dev/null 2>&1||addgroup --system "$group";done
for user in phantom-ctrl phantom-net phantom-mdns;do
  getent group "$user" >/dev/null 2>&1||addgroup --system "$user"
  getent passwd "$user" >/dev/null 2>&1||adduser --system --ingroup "$user" --home /var/lib/phantom --no-create-home --disabled-password --shell /usr/sbin/nologin "$user"
done
adduser phantom-ctrl phantom-motor >/dev/null 2>&1||true
adduser phantom-ctrl phantom-ipc >/dev/null 2>&1||true
adduser phantom-ctrl phantom-safety-ipc >/dev/null 2>&1||true
adduser phantom-net phantom-ipc >/dev/null 2>&1||true
getent group ev3dev >/dev/null 2>&1&&adduser phantom-ctrl ev3dev >/dev/null 2>&1||true
# The bench characterization harness provisions NOPASSWD root for a binary in a
# robot-writable path. That is acceptable for an isolated measurement rig, but on
# a brick that then runs production it is a trivial bypass of the phantom-ctrl /
# phantom-net privilege separation the safety argument depends on. Remove it, and
# refuse to install if it cannot be removed.
bench_sudoers=/etc/sudoers.d/phantom-ev3-bench
if test -e "$bench_sudoers"; then
  echo "removing bench sudo rule before a production install: $bench_sudoers" >&2
  rm -f "$bench_sudoers"
  test ! -e "$bench_sudoers" || { echo "refusing to install while the bench sudo rule is present" >&2;exit 1; }
fi
for stray in /etc/sudoers.d/phantom-*; do
  case "$stray" in *'phantom-*') continue;; esac
  echo "refusing to install: unexpected phantom sudoers fragment $stray" >&2
  exit 1
done

install_runtime_metadata(){
  release=$1
  network_group=$(sed -n 's/^Group=//p' "$release/systemd/phantom-network.service"|head -n 1)
  case "$network_group" in ''|*[!A-Za-z0-9._-]*) echo "invalid network service group in $release" >&2;return 1;;esac
  getent group "$network_group" >/dev/null 2>&1||{ echo "network service group is unavailable: $network_group" >&2;return 1; }
  for unit in $units;do install -m 0644 "$release/systemd/$unit" "/etc/systemd/system/$unit"||return 1;done
  install -m 0644 "$release/tmpfiles/phantom.conf" /etc/tmpfiles.d/phantom.conf||return 1
  systemctl daemon-reload||return 1
  # Services are stopped before every call. Remove release-specific sockets,
  # status files and subdirectories while preserving the lease inode itself;
  # tmpfiles then recreates exactly the selected release's volatile layout.
  if test -d /run/phantom;then
    find /run/phantom -mindepth 1 -maxdepth 1 ! -name motor-control.lock -exec rm -rf -- {} +||return 1
  fi
  systemd-tmpfiles --create /etc/tmpfiles.d/phantom.conf||return 1
  if test -d /var/lib/phantom/secrets;then
    chown "root:$network_group" /var/lib/phantom/secrets||return 1
    chmod 0750 /var/lib/phantom/secrets||return 1
    find /var/lib/phantom/secrets -type f -exec chown "root:$network_group" {} + -exec chmod 0640 {} +||return 1
  fi
}
runtime_metadata_matches(){
  release=$1
  for unit in $units;do cmp -s "$release/systemd/$unit" "/etc/systemd/system/$unit"||return 1;done
  cmp -s "$release/tmpfiles/phantom.conf" /etc/tmpfiles.d/phantom.conf
}
all_services_active(){
  for unit in $runtime_services;do
    systemctl is-active --quiet "$unit"||{ echo "required service is not active: $unit" >&2;return 1; }
  done
}
previous=$(readlink -f "$root/current" 2>/dev/null||true)
rollback(){
  rollback_status=0
  systemctl stop phantom-mdns.service phantom-network.service phantom-controller.service phantom-wifi-autoconnect.service phantom-safety.service phantom.target||rollback_status=1
  if test -n "$previous";then
    ln -sfn "$previous" "$root/current"||rollback_status=1
    install_runtime_metadata "$previous"||rollback_status=1
    runtime_metadata_matches "$previous"||{ echo "rollback metadata does not match previous release" >&2;rollback_status=1; }
    if test "$rollback_status" = 0;then
      systemctl start phantom.target||rollback_status=1
      all_services_active||rollback_status=1
    fi
    if test "$rollback_status" != 0;then
      systemctl stop phantom-mdns.service phantom-network.service phantom-controller.service phantom-wifi-autoconnect.service phantom-safety.service phantom.target||true
    fi
  else
    rm -f "$root/current"
    for unit in $units;do rm -f "/etc/systemd/system/$unit";done
    rm -f /etc/tmpfiles.d/phantom.conf
    systemctl daemon-reload||rollback_status=1
  fi
  rm -rf -- "$dest"
  test "$rollback_status" = 0
}
fail_with_rollback(){
  reason=$1
  echo "$reason; rolling back release metadata and current symlink" >&2
  rollback||echo "ROLLBACK FAILED: manual recovery is required before another install" >&2
  exit 1
}

systemctl stop phantom-mdns.service phantom-network.service phantom-controller.service phantom-wifi-autoconnect.service phantom-safety.service phantom.target||true
if test -n "$previous";then ln -sfn "$previous" "$root/previous";fi
ln -sfn "$dest" "$root/current"||fail_with_rollback "cannot activate candidate symlink"
install_runtime_metadata "$dest"||fail_with_rollback "cannot install candidate runtime metadata"
runtime_metadata_matches "$dest"||fail_with_rollback "installed runtime metadata differs from candidate"
systemctl start phantom.target||fail_with_rollback "candidate target failed to start"
all_services_active||fail_with_rollback "candidate service startup check failed"
"$dest/bin/phantom-device-auto"||fail_with_rollback "candidate DEVICE AUTO failed"
