# EV3 bench: retain reproducible tooling and summary reports, not local captures.
/build/
/results/ev3/raw/
/results/ev3/environment.json
/results/ev3/environment.txt

# Unity build artifacts and crash reports
*.apk
*.aab
*.unitypackage
sysinfo.txt
*.stacktrace

# Quest validation local compiler/test output
/results/quest/*.dll
/results/quest/*.log
/results/quest/*.jsonl
/results/quest/*.xml
/results/quest/environment.json
/results/quest/runs/
/results/quest/device-pulls/
/results/quest/device-auto/
/results/quest/q4-latest/
/results/quest/summaries/QUEST_ARCHITECTURE_RECOMMENDATIONS.md
/results/quest/summaries/QUEST_VALIDATION_REPORT.md
/results/quest/summaries/USER_CALIBRATION_REPORT.md
/results/quest/v20-physical-*/QUEST_ARCHITECTURE_RECOMMENDATIONS.md
/results/quest/v20-physical-*/USER_CALIBRATION_REPORT.md
/results/quest/smoke/
/results/pre-install/*.json
/.gradle-quest/
/PhantomQuest/.utmp/
/PhantomQuest/Assets/XR/Temp/
/PhantomQuest/Assets/XR/Temp.meta
/PhantomQuest/Assets/Resources/PerformanceTestRunInfo.json*
/PhantomQuest/Assets/Resources/PerformanceTestRunSettings.json*

# Meta XR local editor/debug-agent state. DevAgentSettings can contain an
# access token and a developer workstation address.
/PhantomQuest/Assets/Resources/DevAgentSettings.asset
/PhantomQuest/Assets/Resources/DevAgentSettings.asset.meta
/PhantomQuest/Assets/Resources/ImmersiveDebuggerSettings.asset
/PhantomQuest/Assets/Resources/ImmersiveDebuggerSettings.asset.meta

