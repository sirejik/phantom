[Unit]
Description=PHANTOM reconnect provisioned Wi-Fi profile
Requires=connman.service
After=connman.service
Before=phantom-controller.service phantom-network.service phantom-mdns.service

[Service]
Type=oneshot
ExecStart=/usr/local/libexec/phantom-maintenance/wifi-autoconnect
RemainAfterExit=yes
# Must exceed the helper's own bounded retry budget (worst case 80 s).
TimeoutStartSec=90
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
